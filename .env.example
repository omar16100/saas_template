# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SaaS Template"
NODE_ENV=development

# === Better Auth ===
BETTER_AUTH_SECRET=replace_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000
# Passkey RP ID — must match production apex. Preview domains cannot share credentials.
BETTER_AUTH_RP_ID=localhost

# === OAuth providers (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Stripe (use TEST keys in preview, LIVE only in production) ===
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx

# === Resend ===
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@example.com

# === Turnstile ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Analytics ===
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# === SEO / Search Console ===
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=

# === Logging ===
AXIOM_TOKEN=
AXIOM_DATASET=

# === Cloudflare (bindings are set in wrangler.toml; these are for local only) ===
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
